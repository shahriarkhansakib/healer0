# =============================================================================
# APP & SERVER
# =============================================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:5007"
NEXT_PUBLIC_API_URL="http://localhost:5007"

# =============================================================================
# DATABASE & CACHE
# =============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5455/healer_db"
REDIS_URL="redis://127.0.0.1:6303"

# Production Upstash Redis (Used when NODE_ENV="production")
# UPSTASH_URL="https://xxx.upstash.io"
# UPSTASH_TOKEN="xxx"

# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================
BETTER_AUTH_SECRET="super-secret-better-auth-key-change-me"
BETTER_AUTH_URL="http://localhost:5007"

# =============================================================================
# TRANSACTIONAL EMAIL (Resend)
# =============================================================================
RESEND_API_KEY="re_xxxxxxxxxxxx"

# =============================================================================
# STORAGE (Cloudflare R2)
# =============================================================================
R2_BUCKET_NAME="healer-uploads"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"
